@model IEnumerable<AltinKasap.Web.Models.Announcement>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Duyurular";
    var now = DateTime.Now;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count() duyuru</p>
    <a asp-action="Create" class="btn btn-ak-primary">
        <i class="fa-solid fa-plus"></i> Yeni Duyuru
    </a>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center text-muted py-5">
        <i class="fa-solid fa-bullhorn" style="font-size:2.5rem;opacity:0.4"></i>
        <p class="mt-3 mb-0">Henüz duyuru yok. <a asp-action="Create">İlk duyuruyu oluşturun</a>.</p>
    </div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Başlık</th>
                        <th>Tarih Aralığı</th>
                        <th>Durum</th>
                        <th class="text-end">Eylemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var status = !a.IsActive ? ("Pasif", "danger")
                            : (a.StartDate > now) ? ("Henüz Başlamadı", "info")
                            : (a.EndDate < now) ? ("Süresi Doldu", "secondary")
                            : ("Aktif", "success");
                        <tr>
                            <td>
                                <span class="badge me-2" style="background-color:@a.BackgroundColor;color:@a.TextColor;">&nbsp;</span>
                                <strong>@a.Title</strong>
                            </td>
                            <td class="small">
                                @a.StartDate.ToString("dd.MM.yyyy HH:mm")<br />
                                <span class="text-muted">→ @a.EndDate.ToString("dd.MM.yyyy HH:mm")</span>
                            </td>
                            <td><span class="badge bg-@status.Item2">@status.Item1</span></td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
