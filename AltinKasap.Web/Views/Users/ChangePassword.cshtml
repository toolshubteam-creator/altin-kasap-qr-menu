@model AltinKasap.Web.ViewModels.ChangePasswordViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.IsSelf ? "Şifremi Değiştir" : $"Şifre Sıfırla — {Model.UserEmail}";
}

<div class="ak-form-card">
    @if (!Model.IsSelf)
    {
        <div class="alert alert-info">
            <i class="fa-solid fa-circle-info"></i>
            Başka bir kullanıcının şifresini sıfırlıyorsunuz: <strong>@Model.UserEmail</strong>
        </div>
    }

    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />
        <input asp-for="UserEmail" type="hidden" />
        <input asp-for="IsSelf" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"
             style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

        <div class="row g-3">
            @if (Model.IsSelf)
            {
                <div class="col-md-6">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6"></div>
            }

            <div class="col-md-6">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <small class="text-muted">En az 8 karakter, en az bir büyük harf, küçük harf ve rakam.</small>
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-ak-primary">
                <i class="fa-solid fa-check"></i> @(Model.IsSelf ? "Şifremi Değiştir" : "Şifreyi Sıfırla")
            </button>
            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Geri
            </a>
        </div>
    </form>
</div>
