@model List<AltinKasap.Web.ViewModels.UserListItemViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count kullanıcı</p>
    <a asp-action="Create" class="btn btn-ak-primary">
        <i class="fa-solid fa-user-plus"></i> Yeni Kullanıcı
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>E-posta</th>
                    <th>Ad Soyad</th>
                    <th>Roller</th>
                    <th>Son Giriş</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td><strong>@u.Email</strong></td>
                        <td>@(u.FullName ?? "—")</td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge bg-warning text-dark">@r</span>
                            }
                        </td>
                        <td>@(u.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "Henüz giriş yok")</td>
                        <td>
                            @if (u.IsLocked)
                            {
                                <span class="badge bg-danger">Kilitli</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <a asp-action="ChangePassword" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="Şifre Değiştir">
                                <i class="fa-solid fa-key"></i>
                            </a>
                            @if (u.IsLocked)
                            {
                                <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Kilidi Aç">
                                        <i class="fa-solid fa-unlock"></i>
                                    </button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
