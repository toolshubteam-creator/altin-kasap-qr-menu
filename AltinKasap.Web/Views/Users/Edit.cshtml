@model AltinKasap.Web.ViewModels.UserEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="ak-form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"
             style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-ak-primary">
                <i class="fa-solid fa-check"></i> Kaydet
            </button>
            <a asp-action="ChangePassword" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                <i class="fa-solid fa-key"></i> Şifre Değiştir
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i> Geri
            </a>
        </div>
    </form>
</div>
