@model AltinKasap.Web.ViewModels.CategoryFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yeni Kategori";
}

<div class="ak-form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger small"></span>
            <small class="text-muted">Slug otomatik olarak ad'dan üretilir (ör: "Çorbalar &amp; Ezmeler" → corbalar-ezmeler).</small>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="IconClass" class="form-label"></label>
            <input asp-for="IconClass" class="form-control" placeholder="ör: fa-utensils" />
            <span asp-validation-for="IconClass" class="text-danger small"></span>
            <small class="text-muted">Font Awesome 6 sınıf adı. Boş bırakılabilir.</small>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-ak-primary">
            <i class="fa-solid fa-check"></i> Kaydet
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left"></i> Geri
        </a>
    </form>
</div>
