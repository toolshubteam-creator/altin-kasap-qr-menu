@model IEnumerable<AltinKasap.Web.Models.Category>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count() kategori — sıralamak için satırları sürükleyin</p>
    <a asp-action="Create" class="btn btn-ak-primary">
        <i class="fa-solid fa-plus"></i> Yeni Kategori
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:36px"></th>
                    <th>#</th>
                    <th>Sıra</th>
                    <th>İkon</th>
                    <th>Ad</th>
                    <th>Slug</th>
                    <th>Aktif</th>
                    <th class="text-end">Eylemler</th>
                </tr>
            </thead>
            <tbody id="sortable-list" data-sort-type="category">
                @foreach (var c in Model)
                {
                    <tr data-id="@c.Id">
                        <td><span class="drag-handle" title="Sürükle"><i class="fa-solid fa-grip-vertical"></i></span></td>
                        <td>@c.Id</td>
                        <td class="ak-sort-order">@c.SortOrder</td>
                        <td>
                            @if (!string.IsNullOrEmpty(c.IconClass))
                            {
                                <i class="fa-solid @c.IconClass"></i>
                            }
                        </td>
                        <td><strong>@c.Name</strong></td>
                        <td><code>@c.Slug</code></td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@@1.15.2/Sortable.min.js"></script>
}
