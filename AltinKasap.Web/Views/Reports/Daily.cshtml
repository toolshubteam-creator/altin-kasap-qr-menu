@model AltinKasap.Web.ViewModels.ReportViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.Title;
    var date = (DateTime)ViewBag.SelectedDate;
    var prev = date.AddDays(-1).ToString("yyyy-MM-dd");
    var next = date.AddDays(1).ToString("yyyy-MM-dd");
}

@await Html.PartialAsync("_ReportsNav")

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a asp-action="Daily" asp-route-date="@prev" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-chevron-left"></i> Önceki Gün
    </a>
    <form method="get" class="d-inline-flex align-items-center gap-2">
        <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <button type="submit" class="btn btn-sm btn-ak-primary"><i class="fa-solid fa-search"></i></button>
    </form>
    <a asp-action="Daily" asp-route-date="@next" class="btn btn-sm btn-outline-secondary">
        Sonraki Gün <i class="fa-solid fa-chevron-right"></i>
    </a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="ak-kpi-card">
            <p class="ak-kpi-label">Toplam Tarama</p>
            <p class="ak-kpi-value">@Model.Total</p>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <canvas id="chart" height="80"></canvas>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="table-light"><tr><th>Saat</th><th class="text-end">Tarama</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.Labels.Length; i++)
                {
                    <tr><td>@Model.Labels[i]</td><td class="text-end">@Model.Data[i]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('chart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Labels)),
                datasets: [{
                    label: 'Tarama',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Data)),
                    backgroundColor: 'rgba(200, 160, 50, 0.6)',
                    borderColor: '#C8A032',
                    borderWidth: 1
                }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    </script>
}
