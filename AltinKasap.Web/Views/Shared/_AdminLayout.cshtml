<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Altın Kasap Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="ak-admin">
    <nav class="ak-sidebar">
        <div class="ak-sidebar-brand">
            <i class="fa-solid fa-fire-flame-curved"></i>
            <span>Altın Kasap</span>
        </div>
        <ul class="ak-sidebar-menu">
            @{
                var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                string Active(string c) => ctrl.Equals(c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
            }
            <li><a asp-controller="Admin" asp-action="Index" class="@Active("Admin")"><i class="fa-solid fa-gauge-high"></i> Dashboard</a></li>
            <li><a asp-controller="Categories" asp-action="Index" class="@Active("Categories")"><i class="fa-solid fa-list"></i> Kategoriler</a></li>
            <li><a asp-controller="Products" asp-action="Index" class="@Active("Products")"><i class="fa-solid fa-utensils"></i> Ürünler</a></li>
            <li><a asp-controller="QrCodes" asp-action="Index" class="@Active("QrCodes")"><i class="fa-solid fa-qrcode"></i> QR Kodlar</a></li>
            <li><a asp-controller="Reports" asp-action="Daily" class="@Active("Reports")"><i class="fa-solid fa-chart-line"></i> Raporlar</a></li>
            <li class="ak-sidebar-divider"></li>
            <li><a asp-controller="Announcements" asp-action="Index" class="@Active("Announcements")"><i class="fa-solid fa-bullhorn"></i> Duyurular</a></li>
            <li><a asp-controller="DailySpecials" asp-action="Index" class="@Active("DailySpecials")"><i class="fa-solid fa-star"></i> Günün Önerisi</a></li>
            <li class="ak-sidebar-divider"></li>
            <li><a asp-controller="Settings" asp-action="Index" class="@Active("Settings")"><i class="fa-solid fa-gear"></i> Restoran Ayarları</a></li>
            <li class="ak-sidebar-divider"></li>
            <li><a href="/" target="_blank"><i class="fa-solid fa-up-right-from-square"></i> Menüyü Görüntüle</a></li>
        </ul>
        <form asp-controller="Account" asp-action="Logout" method="post" class="ak-sidebar-logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-light w-100">
                <i class="fa-solid fa-right-from-bracket"></i> Çıkış
            </button>
        </form>
    </nav>

    <main class="ak-main">
        <div class="ak-topbar">
            <button class="ak-sidebar-toggle d-md-none" id="akSidebarToggle">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="ak-topbar-title">@ViewData["Title"]</div>
            <div class="ak-topbar-user">
                <i class="fa-solid fa-user-circle"></i>
                <span>@User.Identity?.Name</span>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3">
                <i class="fa-solid fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3">
                <i class="fa-solid fa-triangle-exclamation"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="ak-content">
            <div class="d-none">@Html.AntiForgeryToken()</div>
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
