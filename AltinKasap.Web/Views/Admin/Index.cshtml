@model AltinKasap.Web.ViewModels.DashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="ak-kpi-card">
            <p class="ak-kpi-label"><i class="fa-solid fa-list"></i> Toplam Kategori</p>
            <p class="ak-kpi-value">@Model.TotalCategories</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ak-kpi-card">
            <p class="ak-kpi-label"><i class="fa-solid fa-utensils"></i> Toplam Ürün</p>
            <p class="ak-kpi-value">@Model.TotalProducts</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ak-kpi-card">
            <p class="ak-kpi-label"><i class="fa-solid fa-qrcode"></i> Bugünkü QR Tarama</p>
            <p class="ak-kpi-value">@Model.TodaysScanCount</p>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Son 7 Gün — QR Tarama</h5>
        <canvas id="scanChart" height="80"></canvas>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title mb-3"><i class="fa-solid fa-trophy text-warning"></i> En Çok Taranan QR Kodlar</h5>
                @if (!Model.TopQrCodes.Any())
                {
                    <p class="text-muted mb-0">Henüz QR kod yok veya hiç tarama olmamış.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>Ad</th><th class="text-end">Tarama</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.TopQrCodes)
                            {
                                <tr>
                                    <td>@row.Name</td>
                                    <td class="text-end"><span class="badge bg-secondary">@row.ScanCount</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title mb-3">Hızlı Eylemler</h5>
                <a asp-controller="Categories" asp-action="Create" class="btn btn-ak-primary me-2 mb-2">
                    <i class="fa-solid fa-plus"></i> Kategori Ekle
                </a>
                <a asp-controller="Products" asp-action="Create" class="btn btn-ak-primary me-2 mb-2">
                    <i class="fa-solid fa-plus"></i> Ürün Ekle
                </a>
                <a asp-controller="QrCodes" asp-action="Create" class="btn btn-ak-primary mb-2">
                    <i class="fa-solid fa-qrcode"></i> QR Kod Oluştur
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var ctx = document.getElementById('scanChart');
            if (!ctx) return;
            var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last7DaysReport.Labels));
            var data = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Last7DaysReport.Data));
            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tarama',
                        data: data,
                        borderColor: '#C8A032',
                        backgroundColor: 'rgba(200, 160, 50, 0.15)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        })();
    </script>
}
