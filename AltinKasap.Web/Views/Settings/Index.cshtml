@model AltinKasap.Web.ViewModels.RestaurantFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Restoran Ayarları";
}

<form asp-action="Index" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="ExistingLogoPath" type="hidden" />
    <input asp-for="ExistingCoverPath" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fa-solid fa-store"></i> Temel Bilgiler</h5>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PrimaryColor" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="PrimaryColor" type="color" class="form-control form-control-color" />
                            <input asp-for="PrimaryColor" type="text" class="form-control" />
                        </div>
                        <span asp-validation-for="PrimaryColor" class="text-danger small"></span>
                    </div>

                    <h6 class="mt-4 mb-2">Sosyal Medya</h6>
                    <div class="mb-2">
                        <label asp-for="InstagramUrl" class="form-label small mb-1"></label>
                        <input asp-for="InstagramUrl" class="form-control form-control-sm" placeholder="https://instagram.com/..." />
                        <span asp-validation-for="InstagramUrl" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="FacebookUrl" class="form-label small mb-1"></label>
                        <input asp-for="FacebookUrl" class="form-control form-control-sm" placeholder="https://facebook.com/..." />
                        <span asp-validation-for="FacebookUrl" class="text-danger small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="WebsiteUrl" class="form-label small mb-1"></label>
                        <input asp-for="WebsiteUrl" class="form-control form-control-sm" placeholder="https://..." />
                        <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fa-solid fa-image"></i> Görseller</h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Logo</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingLogoPath))
                        {
                            <div class="mb-2">
                                <img src="@Model.ExistingLogoPath" alt="Logo" class="ak-image-preview" style="display:block; max-width:160px;" />
                            </div>
                            <div class="form-check mb-2">
                                <input asp-for="RemoveLogo" class="form-check-input" />
                                <label asp-for="RemoveLogo" class="form-check-label"></label>
                            </div>
                        }
                        <input asp-for="LogoFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
                        <small class="text-muted">Maks. 5 MB. 400×400'e boyutlandırılır.</small>
                        <span asp-validation-for="LogoFile" class="text-danger small d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Kapak Görseli</label>
                        @if (!string.IsNullOrEmpty(Model.ExistingCoverPath))
                        {
                            <div class="mb-2">
                                <img src="@Model.ExistingCoverPath" alt="Kapak" class="ak-image-preview" style="display:block; max-width:100%;" />
                            </div>
                            <div class="form-check mb-2">
                                <input asp-for="RemoveCover" class="form-check-input" />
                                <label asp-for="RemoveCover" class="form-check-label"></label>
                            </div>
                        }
                        <input asp-for="CoverFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
                        <small class="text-muted">Maks. 5 MB. 1600×600'e boyutlandırılır.</small>
                        <span asp-validation-for="CoverFile" class="text-danger small d-block"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-ak-primary">
            <i class="fa-solid fa-check"></i> Kaydet
        </button>
    </div>
</form>
